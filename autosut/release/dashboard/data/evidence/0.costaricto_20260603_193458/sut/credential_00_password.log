$ 
if id "reconuser" >/dev/null 2>&1; then
  :
elif command -v adduser >/dev/null 2>&1 && adduser --help 2>&1 | grep -q "BusyBox\|Alpine"; then
  adduser -D -s /bin/sh "reconuser"
elif command -v useradd >/dev/null 2>&1; then
  useradd -m -s /bin/bash "reconuser"
elif command -v adduser >/dev/null 2>&1; then
  adduser --disabled-password --gecos "" "reconuser"
else
  echo "no usable user-create tool" 1>&2
  exit 1
fi
echo "reconuser:reconpass123" | chpasswd

exit_code: 0
--- stdout ---

--- stderr ---
useradd: warning: the home directory /home/reconuser already exists.
useradd: Not copying any file from skel directory into it.

