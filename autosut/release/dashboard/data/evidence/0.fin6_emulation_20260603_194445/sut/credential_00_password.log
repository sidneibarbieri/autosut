$ 
if id "vulnuser" >/dev/null 2>&1; then
  :
elif command -v adduser >/dev/null 2>&1 && adduser --help 2>&1 | grep -q "BusyBox\|Alpine"; then
  adduser -D -s /bin/sh "vulnuser"
elif command -v useradd >/dev/null 2>&1; then
  useradd -m -s /bin/bash "vulnuser"
elif command -v adduser >/dev/null 2>&1; then
  adduser --disabled-password --gecos "" "vulnuser"
else
  echo "no usable user-create tool" 1>&2
  exit 1
fi
echo "vulnuser:vulnpass123" | chpasswd

exit_code: 0
--- stdout ---

--- stderr ---
useradd: warning: the home directory /home/vulnuser already exists.
useradd: Not copying any file from skel directory into it.

