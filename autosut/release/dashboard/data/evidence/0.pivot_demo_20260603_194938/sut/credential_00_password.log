$ 
if id "labuser" >/dev/null 2>&1; then
  :
elif command -v adduser >/dev/null 2>&1 && adduser --help 2>&1 | grep -q "BusyBox\|Alpine"; then
  adduser -D -s /bin/sh "labuser"
elif command -v useradd >/dev/null 2>&1; then
  useradd -m -s /bin/bash "labuser"
elif command -v adduser >/dev/null 2>&1; then
  adduser --disabled-password --gecos "" "labuser"
else
  echo "no usable user-create tool" 1>&2
  exit 1
fi
echo "labuser:Lab-Demo-2026!" | chpasswd

exit_code: 0
