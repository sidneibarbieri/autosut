$ 
if id "clouduser" >/dev/null 2>&1; then
  :
elif command -v adduser >/dev/null 2>&1 && adduser --help 2>&1 | grep -q "BusyBox\|Alpine"; then
  adduser -D -s /bin/sh "clouduser"
elif command -v useradd >/dev/null 2>&1; then
  useradd -m -s /bin/bash "clouduser"
elif command -v adduser >/dev/null 2>&1; then
  adduser --disabled-password --gecos "" "clouduser"
else
  echo "no usable user-create tool" 1>&2
  exit 1
fi
echo "clouduser:cloudpass123" | chpasswd

exit_code: 0
--- stdout ---

--- stderr ---
useradd: warning: the home directory /home/clouduser already exists.
useradd: Not copying any file from skel directory into it.

