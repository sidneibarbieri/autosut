$ 
if id "dustops" >/dev/null 2>&1; then
  :
elif command -v adduser >/dev/null 2>&1 && adduser --help 2>&1 | grep -q "BusyBox\|Alpine"; then
  adduser -D -s /bin/sh "dustops"
elif command -v useradd >/dev/null 2>&1; then
  useradd -m -s /bin/bash "dustops"
elif command -v adduser >/dev/null 2>&1; then
  adduser --disabled-password --gecos "" "dustops"
else
  echo "no usable user-create tool" 1>&2
  exit 1
fi
echo "dustops:Dust2024!" | chpasswd

exit_code: 0
--- stdout ---

--- stderr ---
useradd: warning: the home directory /home/dustops already exists.
useradd: Not copying any file from skel directory into it.

